rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /communes/{communeId} {
      allow read, write: if true;
    }
    match /surveyAreas/{areaId} {
      allow read, write: if true;
    }
    match /households/{householdId} {
      allow read, write: if true;
    }
    match /surveyors/{surveyorId} {
      allow read, write: if true;
    }
    match /enterprises_01/{enterpriseId} {
      allow read, write: if true;
    }
    match /establishments_02/{establishmentId} {
      allow read, write: if true;
    }
    match /industrial_summaries/{summaryId} {
      allow read, write: if true;
    }
  }
}
