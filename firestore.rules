rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Departments collection: dynamic department list
    match /departments/{deptId} {
      allow read, write: if true;
    }

    // Users and profiles collection: account security & area assignments
    match /users/{userId} {
      allow read, write: if true;
    }

    // Surveys & Questionnaires
    match /surveys/{surveyId} {
      allow read, write: if true;
    }
    
    // Administrative units: communes and areas
    match /communes/{communeId} {
      allow read, write: if true;
    }

    match /surveyAreas/{areaId} {
      allow read, write: if true;
    }
    
    // Household survey data & lists
    match /households/{householdId} {
      allow read, write: if true;
    }
    
    // Surveyors & Investigators
    match /surveyors/{surveyorId} {
      allow read, write: if true;
    }

    // Industrial survey module collections (enterprises, establishments, summaries)
    match /enterprises_01/{id} {
      allow read, write: if true;
    }

    match /establishments_02/{id} {
      allow read, write: if true;
    }

    match /industrial_summaries/{id} {
      allow read, write: if true;
    }

    // Fallback protection for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
