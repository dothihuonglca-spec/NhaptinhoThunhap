rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPERVISOR';
    }

    function isSurveyor() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SURVEYOR';
    }

    function userData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {};
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Communes - all authenticated users can read/write
    match /communes/{communeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Survey Areas - all authenticated users can read/write
    match /surveyAreas/{areaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Surveyors - authenticated users can read/write
    match /surveyors/{surveyorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Households - authenticated users can read, admins/supervisors can write
    match /households/{householdId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isSupervisor();
      allow update: if isAdmin() || isSupervisor();
      allow delete: if isAdmin();
    }

    // Example data collection
    match /surveys/{surveyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
  }
}
